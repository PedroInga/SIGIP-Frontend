# nginx del frontend: sirve la SPA de Angular y reenvía /api/* al API Gateway.
# Así el navegador usa un solo origen (sin CORS) y el gateway sigue siendo el único punto de entrada.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        # Resuelve el gateway en cada peticion (DNS de Docker / del host) para no quedarse con una IP
        # vieja cuando el contenedor del gateway se recrea. API_GATEWAY_URL va sin "/" final.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $gateway ${API_GATEWAY_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $gateway;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;   # necesario si el gateway está en HTTPS (nube)
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Archivos con hash: caché larga
    location ~* \.(js|css|woff2?|ico|png|svg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Rutas de Angular (/pedidos/5, /dashboard...) devuelven index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
